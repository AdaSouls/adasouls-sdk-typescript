{
  "name": "@adasouls/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for AdaSouls: a typed, zero-dependency client over the AdaSouls API that gives agent runtimes a domain-verb API (agent.execute({ capability: 'pay', ... })).",
  "license": "MIT",
  "homepage": "https://github.com/AdaSouls/adasouls-sdk-typescript#readme",
  "keywords": [
    "adasouls",
    "alma",
    "ai-agents",
    "agent-payments",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AdaSouls/adasouls-sdk-typescript.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.7.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
